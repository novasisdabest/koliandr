---
// Přepínač tmavá / světlá. Stav drží atribut data-theme na <html>,
// volbu si pamatuje localStorage. Bez volby se řídí nastavením systému.
---

<button
  id="theme-toggle"
  type="button"
  class="rounded-full border border-white/10 bg-white/5 p-2.5 text-slate-300 transition-colors hover:text-white"
  aria-label="Přepnout světlý režim"
>
  <!-- Měsíc: vidět v tmavém režimu (nabízí přepnutí na světlo) -->
  <svg
    class="h-5 w-5 [:root[data-theme=light]_&]:hidden"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path stroke-linecap="round" stroke-linejoin="round" d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z"></path>
  </svg>
  <!-- Slunce: vidět ve světlém režimu -->
  <svg
    class="hidden h-5 w-5 [:root[data-theme=light]_&]:block"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path
      stroke-linecap="round"
      d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
    ></path>
  </svg>
</button>

<script>
  const root = document.documentElement;
  const btn = document.getElementById('theme-toggle');

  const sync = (theme: string): void => {
    root.dataset.theme = theme;
    btn?.setAttribute('aria-label', theme === 'dark' ? 'Přepnout světlý režim' : 'Přepnout tmavý režim');
  };

  btn?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    // Třída zapne krátký přechod barev; hned ji zase sundáme,
    // aby netlumila ostatní animace na stránce.
    root.classList.add('theme-switching');
    window.setTimeout(() => root.classList.remove('theme-switching'), 220);
    try {
      localStorage.setItem('zeeko-theme', next);
    } catch {
      /* private mode — volba prostě nepřežije reload */
    }
    sync(next);
  });

</script>
