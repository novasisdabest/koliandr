---
interface Props {
  eyebrow: string;
  title: string;
  aside?: string;
}
const { eyebrow, title, aside } = Astro.props;
---

<div class="mb-16 flex flex-col justify-between gap-4 md:flex-row md:items-end">
  <div>
    <span class="font-mono text-xs uppercase tracking-widest text-burgundy-400">{eyebrow}</span>
    <h2 class="mt-2 text-3xl font-extrabold tracking-tight text-white sm:text-4xl">{title}</h2>
  </div>
  {aside && <p class="font-mono text-sm text-burgundy-300">{aside}</p>}
</div>
