---
import SectionHeading from './SectionHeading.astro';
import InstagramIcon from './InstagramIcon.astro';
import { TOPICS } from '../data/content';
import { CONTACT } from '../data/site';
---

<section id="know-how" class="border-t border-line bg-dark-800 py-24">
  <div class="mx-auto max-w-7xl px-6">
    <SectionHeading
      eyebrow="Odbornost z praxe"
      title="Co mě na nemovitostech zajímá"
      aside="Témata a know-how"
    />

    <ul class="mb-16 flex flex-wrap gap-3">
      {
        TOPICS.map((topic) => (
          <li class="rounded-full border border-line-strong bg-dark-900 px-5 py-3 text-sm text-burgundy-200 transition-all hover:border-burgundy-500/80 hover:bg-dark-800">
            {topic}
          </li>
        ))
      }
    </ul>

    <div
      class="relative flex flex-col items-center justify-between gap-8 overflow-hidden rounded-3xl border border-line-soft bg-gradient-to-br from-dark-900 to-dark-800 p-8 shadow-2xl sm:p-12 md:flex-row"
    >
      <div class="pointer-events-none absolute -bottom-20 -right-20 h-64 w-64 rounded-full bg-gradient-to-br from-burgundy-600/20 to-purple-900/20 blur-3xl"></div>

      <div class="relative z-10 space-y-3">
        <p class="inline-flex items-center gap-2 font-mono text-xs text-burgundy-300">
          <InstagramIcon class="h-4 w-4" />
          Instagram {CONTACT.instagramHandle}
        </p>
        <h3 class="text-2xl font-bold text-white">Případy z praxe přímo z terénu</h3>
        <p class="max-w-xl text-sm leading-relaxed text-burgundy-100/80 sm:text-base">
          Sdílím tam případy z praxe, investice, nemovitosti s právními vadami, vyjednávání a věci,
          které se do běžné realitní prezentace nevejdou.
        </p>
      </div>

      <a
        href={CONTACT.instagram}
        target="_blank"
        rel="noopener noreferrer"
        class="relative z-10 flex items-center gap-2 whitespace-nowrap rounded-full border border-burgundy-600/50 bg-dark-800 px-8 py-4 text-sm font-semibold text-white shadow-xl transition-all hover:-translate-y-0.5 hover:bg-dark-700"
      >
        Sledovat profil
        <span class="font-mono">&rarr;</span>
      </a>
    </div>
  </div>
</section>
