---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { SITE } from '../data/site';

// Portrét zatím v repu není. `import.meta.glob` ho najde, jakmile ho tam
// nahraješ jako src/assets/portrait.{png,jpg,jpeg,webp} — a do té doby
// build NESPADNE, jen se vykreslí monogramový placeholder.
const found = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/portrait.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);
const portrait: ImageMetadata | undefined = Object.values(found)[0]?.default;
---

<section
  class="relative overflow-hidden bg-paper-900 pb-16 pt-8 lg:flex lg:min-h-[calc(100svh-5rem)] lg:items-stretch lg:py-[clamp(1.5rem,3vh,3rem)]"
>
  <div class="texture-grain pointer-events-none absolute inset-0 opacity-10 mix-blend-screen"></div>
  <div
    class="pointer-events-none absolute left-1/4 top-0 h-[800px] w-[800px] rounded-full bg-glow/20 blur-[150px]"
  >
  </div>

  <div class="relative z-10 mx-auto w-full max-w-7xl px-4 sm:px-6 lg:flex lg:items-stretch">
    <div
      class="relative mx-auto flex w-full max-w-7xl flex-col rounded-sm bg-paper-700 lg:my-0 elevation-book lg:flex-row lg:before:absolute lg:before:-inset-4 lg:before:-z-10 lg:before:rounded-xl lg:before:bg-paper-500 lg:before:shadow-2xl lg:before:content-['']"
    >
      <!-- Levá stránka: text -->
      <div
        class="book-crease relative flex w-full flex-col justify-center overflow-hidden bg-gradient-to-br from-paper-600 to-paper-700 p-8 sm:p-12 lg:w-[58%] lg:rounded-l-sm lg:p-[clamp(2rem,4.5vh,5rem)]"
      >
        <div
          class="pointer-events-none absolute inset-0 bg-gradient-to-r from-transparent via-white/[0.02] to-transparent"
        >
        </div>

        <div class="relative z-10 space-y-8 lg:space-y-[clamp(1.25rem,3vh,2rem)]">
          <!-- Text je v HTML celý: bez JS i pro čtečky je kompletní,
               skript ho jen přepíše a odťuká znak po znaku. Žádný layout shift. -->
          <p
            class="flex items-baseline gap-1 font-mono text-sm uppercase tracking-[0.22em] text-burgundy-300 sm:text-base"
            aria-label="Zdeněk Koliandr — investor a vyjednavač"
          >
            <span data-typewriter aria-hidden="true">ZDENĚK KOLIANDR — INVESTOR &amp; VYJEDNAVAČ</span>
            <span
              class="caret-blink inline-block h-[0.95em] w-[0.5em] shrink-0 translate-y-[0.08em] bg-burgundy-500"
              aria-hidden="true"></span>
          </p>

          <h1
            class="font-serif text-4xl font-extrabold leading-[1.1] tracking-tight text-burgundy-50 sm:text-5xl lg:text-[clamp(3.5rem,7vh,6rem)]"
          >
            <!-- &nbsp; drží dvojici pohromadě: „moje" nikdy nezůstane samo
                 na konci řádku. Zalomit jinde v té větě prohlížeč pořád smí. -->
            Nemovitosti jsou moje&nbsp;práce.<br />
            <span
              class="bg-gradient-to-r from-burgundy-300 to-burgundy-100 bg-clip-text font-serif italic text-transparent"
            >
              Složité případy
            </span><br />
            moje specializace.
          </h1>

          <p class="max-w-md text-lg font-normal leading-relaxed text-burgundy-100/70 lg:text-[clamp(0.95rem,1.9vh,1.125rem)]">
            Více než 20 let se pohybuji v realitách a specializuji se na nemovitosti, kde nestačí jen
            podívat se na cenu a list vlastnictví. Exekuce, zástavy, dluhy nebo insolvence.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-4 lg:pt-[clamp(0.25rem,1.5vh,1rem)]">
            <a
              href="#kontakt"
              class="rounded-full border border-burgundy-500/30 bg-gradient-to-r from-burgundy-700 to-burgundy-900 px-8 py-4 text-sm font-semibold lg:py-[clamp(0.75rem,1.7vh,1rem)] text-on-accent elevation-btn transition-all hover:-translate-y-0.5 hover:from-burgundy-600 hover:to-burgundy-800"
            >
              Probrat konkrétní případ
            </a>
            <a
              href="#o-mne"
              class="rounded-full px-8 py-4 text-sm font-semibold lg:py-[clamp(0.75rem,1.7vh,1rem)] text-burgundy-200 underline decoration-burgundy-700/50 underline-offset-4 transition-all hover:text-white hover:decoration-burgundy-400"
            >
              Poznat můj příběh
            </a>
          </div>
        </div>
      </div>

      <!-- Pravá stránka: fotografie -->
      <div
        class="book-shadow relative flex w-full items-center justify-center overflow-hidden bg-paper-800 lg:w-[42%] lg:rounded-r-sm"
      >
        <div class="group relative h-full min-h-[400px] w-full sm:min-h-[500px] lg:min-h-full">
          {
            portrait ? (
              <Image
                src={portrait}
                alt={`${SITE.owner} — ${SITE.role}`}
                widths={[480, 800, 1200]}
                sizes="(min-width: 1024px) 50vw, 100vw"
                format="avif"
                loading="eager"
                fetchpriority="high"
                class="absolute inset-0 h-full w-full object-cover object-top opacity-90 transition-transform duration-1000 group-hover:scale-105 lg:object-center"
              />
            ) : (
              <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-gradient-to-br from-burgundy-950 to-paper-800">
                <span class="font-serif text-7xl font-bold text-burgundy-200/30">ZK</span>
                <span class="font-mono text-[10px] uppercase tracking-widest text-burgundy-300/40">
                  src/assets/portrait.jpg
                </span>
              </div>
            )
          }

          <div class="pointer-events-none absolute inset-0 photo-inset"></div>
          <div
            class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,_transparent_40%,_rgba(26,11,14,0.6)_100%)]"
          >
          </div>
          <div
            class="pointer-events-none absolute inset-0 bg-gradient-to-t from-dark-900/80 via-transparent to-transparent lg:hidden"
          >
          </div>

          <div
            class="absolute bottom-6 right-6 z-10 rounded-lg border border-line-faint bg-dark-900/80 px-4 py-2 text-right opacity-0 backdrop-blur-sm transition-opacity duration-500 group-hover:opacity-100 lg:bottom-8 lg:right-8"
          >
            <p class="text-sm font-bold text-white">{SITE.owner}</p>
            <p class="font-mono text-[10px] text-burgundy-300">{SITE.role}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const el = document.querySelector<HTMLElement>('[data-typewriter]');
  const motionOk = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

  if (el && motionOk) {
    const full = el.textContent ?? '';
    el.textContent = '';
    let i = 0;
    const tick = (): void => {
      el.textContent = full.slice(0, ++i);
      if (i < full.length) window.setTimeout(tick, 42);
    };
    window.setTimeout(tick, 300);
  }
</script>
