---
// Self-hostované fonty: žádný požadavek na fonts.googleapis.com
// (rychlejší first paint + odpadá předávání IP návštěvníka třetí straně).
import '../styles/fonts.css';
import '../styles/global.css';

import { SITE, CONTACT } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Cesta v /public — absolutní URL se dopočítá ze `site`. */
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, ogImage = '/og-zeeko.jpg', noindex = false } = Astro.props;

// Náhledový build (Cloudflare Pages apod.) se NESMÍ dostat do vyhledávačů —
// jinak si dočasná URL konkuruje s ostrou doménou jako duplicitní obsah.
// Zapíná se proměnnou prostředí PUBLIC_PREVIEW=true, produkce ji nemá.
const isPreview = import.meta.env.PUBLIC_PREVIEW === 'true';

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.owner,
  jobTitle: SITE.role,
  description:
    'Investor a vyjednavač se specializací na nemovitosti zatížené exekucemi, zástavami, dluhy a insolvencí.',
  url: SITE.url,
  email: `mailto:${CONTACT.email}`,
  telephone: CONTACT.phoneDisplay,
  sameAs: [CONTACT.instagram, CONTACT.parkoviste],
  knowsAbout: [
    'Exekuce a nemovitosti',
    'Zástavní práva',
    'Investice do problémových nemovitostí',
    'Vyjednávání s věřiteli',
  ],
};
---

<!doctype html>
<html lang="cs" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(noindex || isPreview) && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="cs_CZ" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#1a0b0e" />

    <!-- Musí běžet PŘED prvním vykreslením, jinak tmavý web na okamžik
         blikne i tomu, kdo má uloženou světlou variantu. Proto je inline
         a synchronní, ne v externím souboru. -->
    <script is:inline>
      (() => {
        // Tmavá je výchozí záměrně — návrh je na ni stavěný a značka s ní
        // pracuje. Systémové nastavení se NEsleduje; světlou dostane jen
        // ten, kdo si ji sám přepne. Volba pak přežije i zavření prohlížeče.
        let stored = null;
        try {
          stored = localStorage.getItem('zeeko-theme');
        } catch {}
        document.documentElement.dataset.theme = stored === 'light' ? 'light' : 'dark';
      })();
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
  </head>
  <body
    class="bg-dark-900 font-sans text-slate-200 antialiased selection:bg-burgundy-600 selection:text-on-accent"
  >
    <a
      href="#top"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-burgundy-600 focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:text-on-accent"
    >
      Přeskočit na obsah
    </a>
    {
      isPreview && (
        <p class="bg-burgundy-600 px-6 py-2 text-center font-mono text-xs text-on-accent">
          Náhled rozpracovaného webu — ostrá adresa bude jiná.
        </p>
      )
    }
    <slot />
  </body>
</html>
