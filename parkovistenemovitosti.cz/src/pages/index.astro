---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Options from '../components/Options.astro';
import Situations from '../components/Situations.astro';
import Process from '../components/Process.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Parkoviště nemovitostí | Řešení pro nemovitosti s dluhy, exekucí nebo zástavou"
  description="Výkup nemovitosti s nájmem a možností zpětného odkupu, nebo zajištěná zápůjčka proti nemovitosti. Pro majitele, kteří řeší dluhy, exekuce, hypotéku nebo zástavu a potřebují peníze či čas."
>
  <Header />
  <main id="top">
    <Hero />
    <Options />
    <Situations />
    <Process />
    <Faq />
    <Contact />
  </main>
  <Footer />
</Base>
