---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { whatsappHref, mailtoHref, CONTACT, SITE } from '../data/site';
---

<!-- overflow-hidden: dekorativní záře je 600px široká a na mobilu
     jinak roztáhne stránku o 105px doprava -->
<section id="kontakt" class="overflow-hidden border-t border-burgundy-900/50 bg-dark-800 py-24">
  <div class="relative mx-auto max-w-7xl px-6">
    <div
      class="pointer-events-none absolute left-1/2 top-1/2 h-[600px] w-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-burgundy-700/10 blur-[120px]"
    >
    </div>

    <div class="relative z-10 mx-auto max-w-3xl text-center">
      <span class="font-mono text-xs uppercase tracking-widest text-burgundy-400">Kontakt</span>
      <h2 class="mt-3 font-serif text-3xl font-extrabold tracking-tight text-burgundy-50 sm:text-5xl">
        Popište situaci vlastními slovy
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-burgundy-100/80">
        Stačí, jaká nemovitost, jaké závazky a kolik zbývá času. Ozve se vám přímo
        {SITE.owner} — ne call centrum.
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a
          href={whatsappHref()}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 rounded-full border border-burgundy-500/30 bg-gradient-to-r from-burgundy-700 to-burgundy-900 px-8 py-4 text-sm font-semibold text-on-accent shadow-xl shadow-black/50 transition-all hover:-translate-y-0.5 hover:from-burgundy-600 hover:to-burgundy-800"
        >
          <WhatsAppIcon class="h-4 w-4 text-emerald-400" />
          Napsat na WhatsApp
        </a>
        <a
          href={CONTACT.phoneHref}
          class="rounded-full border border-burgundy-700/50 bg-dark-900 px-8 py-4 text-sm font-semibold text-burgundy-200 shadow-lg transition-all hover:bg-dark-800"
        >
          Zavolat {CONTACT.phoneDisplay}
        </a>
        <a
          href={mailtoHref()}
          class="rounded-full border border-burgundy-700/50 bg-dark-900 px-8 py-4 text-sm font-semibold text-burgundy-200 shadow-lg transition-all hover:bg-dark-800"
        >
          Napsat e-mail
        </a>
      </div>
    </div>
  </div>
</section>
