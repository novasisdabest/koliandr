---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { whatsappHref } from '../data/site';

interface Props {
  label?: string;
  message?: string;
  variant?: 'primary' | 'block';
  class?: string;
}

const { label = 'Nezávazně se zeptat', message, variant = 'primary', class: className = '' } =
  Astro.props;

const variants: Record<NonNullable<Props['variant']>, string> = {
  primary:
    'inline-flex items-center gap-2 rounded-full border border-burgundy-500/50 bg-gradient-to-r from-burgundy-600 to-burgundy-700 px-5 py-2.5 text-sm font-semibold text-white shadow-lg shadow-burgundy-900/30 transition-all hover:-translate-y-0.5 hover:from-burgundy-500 hover:to-burgundy-600',
  block:
    'flex w-full items-center justify-center gap-2 rounded-xl border border-burgundy-500 bg-burgundy-600 px-5 py-3 text-sm font-semibold text-white',
};
---

<a
  href={whatsappHref(message)}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[variants[variant], className]}
>
  <WhatsAppIcon class="h-4 w-4 text-emerald-400" />
  {label}
</a>
