---
import SectionHeading from './SectionHeading.astro';
import { PROCESS } from '../data/content';
---

<section id="postup" class="border-t border-burgundy-900/50 bg-dark-800 py-24">
  <div class="mx-auto max-w-7xl px-6">
    <SectionHeading eyebrow="Postup" title="Jak to probíhá" aside="Čtyři kroky" />

    <ol class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        PROCESS.map((step) => (
          <li class="group rounded-3xl border border-burgundy-800/50 bg-dark-900 p-8 shadow-lg transition-all hover:border-burgundy-500/80">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl border border-burgundy-600/50 bg-chip font-mono text-sm font-bold text-chip-ink">
              {step.number}
            </span>
            <h3 class="mt-6 text-xl font-bold text-white transition-colors group-hover:text-burgundy-300">
              {step.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-burgundy-100/70">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
